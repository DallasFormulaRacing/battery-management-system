{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "BOOTLOADER": "OFF"
            }
        },
        {
            "name": "Debug",
            "displayName": "Debug (no bootloader, app at 0x08000000)",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "displayName": "Release (no bootloader, app at 0x08000000)",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Debug-BL",
            "displayName": "Debug for the CAN bootloader (app at 0x08008000)",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BOOTLOADER": "ON"
            }
        },
        {
            "name": "Release-BL",
            "displayName": "Release for the CAN bootloader (app at 0x08008000)",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BOOTLOADER": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "Debug", "configurePreset": "Debug" },
        { "name": "Release", "configurePreset": "Release" },
        { "name": "Debug-BL", "configurePreset": "Debug-BL" },
        { "name": "Release-BL", "configurePreset": "Release-BL" }
    ]
}
