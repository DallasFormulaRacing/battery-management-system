BA_ "DBName" "ELCON_TC_HK_L";
BA_ "GenMsgCycleTime" BO_ 2550588916 1000;
BA_ "GenMsgSendType" BO_ 2550588916 0;
BA_ "VFrameFormat" BO_ 2550588916 1;
BA_ "GenMsgCycleTime" BO_ 2566869221 1000;
BA_ "GenMsgSendType" BO_ 2566869221 0;
BA_ "VFrameFormat" BO_ 2566869221 1;
BA_ "GenSigStartValue" SG_ 2550588916 BMS_ChargeControl 1;

VAL_ 2550588916 BMS_ChargeControl 1 "Stop charging (battery protection)" 0 "Start charging" ;
VAL_ 2566869221 ELCON_CurrentDirection 1 "Discharging" 0 "Charging" ;
VAL_ 2566869221 ELCON_HardwareFailure 1 "Hardware failure" 0 "Normal" ;
VAL_ 2566869221 ELCON_OverTemperature 1 "Over temperature protection" 0 "Normal" ;
VAL_ 2566869221 ELCON_InputVoltageFault 1 "Input voltage wrong, charger stopped" 0 "Input voltage normal" ;
VAL_ 2566869221 ELCON_BatteryNotConnected 1 "Battery not connected or reversed" 0 "Battery connected normally" ;
VAL_ 2566869221 ELCON_CommTimeout 1 "Communication receive time-out" 0 "Communication normal" ;

